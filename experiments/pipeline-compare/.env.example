# このファイルを .env にコピーして値を入れる（.env は Git に入らない）

# 必須
GEMINI_API_KEY=
OPENAI_API_KEY=

# 今の流れの競合調査に使う（なければ今の流れは競合調査なしで動く。本番と同じ動き）
SERPAPI_API_KEY=
# SerpAPI の代わりに SearchApi（searchapi.io）を使う場合。入っていればこちらを優先する
SEARCHAPI_API_KEY=

# 任意: 今の流れの関連キーワード取得（本番で設定している場合だけ）
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# モデル（空なら既定値）
GEMINI_MODEL=gemini-3.8-flash
GEMINI_WRITER_MODEL=gemini-3.1-pro-preview
OPENAI_MODEL=gpt-5.4

# 今の流れの時間上限（本番の既定と同じ 140 秒。有料プラン想定なら 380）
SCHEDULER_TIME_BUDGET_SECONDS=140
GEMINI_MAX_PARALLEL=2

# 任意: OpenAI の単価（入れると費用を円で表示する。OpenAI の料金表で確認して入れる）
OPENAI_INPUT_USD_PER_M=
OPENAI_OUTPUT_USD_PER_M=
OPENAI_WEB_SEARCH_USD_PER_CALL=
